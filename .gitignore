# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp

# Node (none is required to build this site, but tooling may appear later)
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# Local env / secrets — never commit the enquiry endpoint credentials
.env
.env.*
!.env.example

# Build & host artefacts
dist/
.cache/
.netlify/
.vercel/

# Generated poster artboards — rebuild with marketing/build_posters.py.
# Each inlines its fonts and photography as data URIs, so they are large and
# entirely reproducible.
marketing/boards/
marketing/posters.html

# Audit screenshots — 12MB of captures, regenerate with
# `claude-seo run capture_screenshot.py`. The written findings are tracked.
farmologic.io-audit/screenshots/

# Local preview server log
.dev/*.log
